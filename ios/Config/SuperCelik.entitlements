<plist version="1.0">
<dict>
	<!-- Empty on purpose: NFC reading is switched off (PhoneModel.nfcEnabled). To bring it back, add the
	     com.apple.developer.nfc.readersession.formats = [TAG] entitlement, the NFCReaderUsageDescription and the
	     ISO 7816 select identifiers (AIDs F381000002534552494401, ...494601, ...525001, A000000063504B43532D3135)
	     to Info.plist again. -->
</dict>
</plist>
