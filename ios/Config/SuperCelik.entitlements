<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NFC reading is switched off (PhoneModel.nfcEnabled). To bring it back, add the
	     com.apple.developer.nfc.readersession.formats = [TAG] entitlement, the NFCReaderUsageDescription and the
	     ISO 7816 select identifiers (AIDs F381000002534552494401, ...494601, ...525001, A000000063504B43532D3135)
	     to Info.plist again. -->
	<!-- Lets the app use the card certificate that the token extension shows to the system (sign-in to eID sites). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.apple.token</string>
	</array>
</dict>
</plist>
