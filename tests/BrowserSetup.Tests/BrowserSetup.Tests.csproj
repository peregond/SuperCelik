<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks of the browser logic that the apps share: Firefox profiles and preferences (windows/SerbiaID.Windows/FirefoxProfiles.cs, used by the
       Linux, Windows and Windows XP / 7 apps) and how the Linux app finds Firefox, Chrome, Edge and the others (linux/SerbiaID.Linux/BrowserSetup.cs).
       Plain console program, no test framework: run it with "dotnet run" and this project's path (exit code 0 = all passed).
       Needs no card, no browser, no NSS tools. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SerbiaID</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\windows\SerbiaID.Windows\FirefoxProfiles.cs" Link="Shared\FirefoxProfiles.cs" />
    <Compile Include="..\..\linux\SerbiaID.Linux\BrowserSetup.cs" Link="Shared\BrowserSetup.cs" />
    <Compile Include="..\..\linux\SerbiaID.Linux\Packaging.cs" Link="Shared\Packaging.cs" />
  </ItemGroup>

</Project>
