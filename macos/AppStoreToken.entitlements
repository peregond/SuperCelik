<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CryptoTokenKit extension (keychain access for Safari / Chrome client certificates): sandbox + smart card. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.smartcard</key><true/>
	<key>com.apple.application-identifier</key><string>TEAMID.com.peregond.supercelik.token</string>
	<key>com.apple.developer.team-identifier</key><string>TEAMID</string>
</dict>
</plist>
