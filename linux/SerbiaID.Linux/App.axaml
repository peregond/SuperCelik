<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SerbiaID.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgBrush" Color="#F3F5F9"/><SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="TextBrush" Color="#1B2430"/><SolidColorBrush x:Key="MutedBrush" Color="#6B7686"/>
          <SolidColorBrush x:Key="LineBrush" Color="#E3E7EE"/><SolidColorBrush x:Key="ControlLineBrush" Color="#D5DAE3"/>
          <SolidColorBrush x:Key="HoverBrush" Color="#EAEEF5"/><SolidColorBrush x:Key="PlaceholderBrush" Color="#EEF1F7"/>
          <SolidColorBrush x:Key="BannerBrush" Color="#FFF4CE"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#C6363C"/><SolidColorBrush x:Key="AccentHoverBrush" Color="#A92D33"/>
          <SolidColorBrush x:Key="RedBrush" Color="#C6363C"/>
          <SolidColorBrush x:Key="OkBrush" Color="#1E8E4E"/><SolidColorBrush x:Key="OkBgBrush" Color="#E6F4EC"/>
          <SolidColorBrush x:Key="WarnBrush" Color="#B26B00"/><SolidColorBrush x:Key="WarnBgBrush" Color="#FFF1DB"/>
          <SolidColorBrush x:Key="BadBrush" Color="#C6363C"/><SolidColorBrush x:Key="BadBgBrush" Color="#FBE7E8"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgBrush" Color="#0F131A"/><SolidColorBrush x:Key="SurfaceBrush" Color="#1A212C"/>
          <SolidColorBrush x:Key="TextBrush" Color="#E8ECF2"/><SolidColorBrush x:Key="MutedBrush" Color="#9AA5B5"/>
          <SolidColorBrush x:Key="LineBrush" Color="#2A3341"/><SolidColorBrush x:Key="ControlLineBrush" Color="#364154"/>
          <SolidColorBrush x:Key="HoverBrush" Color="#263041"/><SolidColorBrush x:Key="PlaceholderBrush" Color="#232C3A"/>
          <SolidColorBrush x:Key="BannerBrush" Color="#4A3F15"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#D23F46"/><SolidColorBrush x:Key="AccentHoverBrush" Color="#E0525A"/>
          <SolidColorBrush x:Key="RedBrush" Color="#E0525A"/>
          <SolidColorBrush x:Key="OkBrush" Color="#5FD08B"/><SolidColorBrush x:Key="OkBgBrush" Color="#1B3A2A"/>
          <SolidColorBrush x:Key="WarnBrush" Color="#F2B45A"/><SolidColorBrush x:Key="WarnBgBrush" Color="#43331A"/>
          <SolidColorBrush x:Key="BadBrush" Color="#FF7A80"/><SolidColorBrush x:Key="BadBgBrush" Color="#472226"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlLineBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinWidth" Value="30"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
  </Application.Styles>
</Application>
