<Window x:Class="SerbiaID.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Super Celik" Icon="app.ico" Width="1020" Height="720" MinWidth="820" MinHeight="600"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Update banner -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#FFF4CE" Padding="24,9" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="BtnUpdate" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Update_Click"/>
                <TextBlock x:Name="LblUpdate" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Source="app.ico" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LblBrand" FontSize="19" FontWeight="Bold"/>
                        <TextBlock x:Name="LblBrandSub" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ComboBox x:Name="CmbLang" DockPanel.Dock="Right" Width="110" Height="32" VerticalContentAlignment="Center" SelectionChanged="Lang_Changed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                    <Border x:Name="PillCard" CornerRadius="14" Padding="12,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotCard" Width="8" Height="8" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LblCard" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="CmbReader" Width="250" Height="32" VerticalContentAlignment="Center" SelectionChanged="CmbReader_Changed"/>
                    <Button x:Name="BtnRefresh" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Refresh_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs">
            <!-- Personal data -->
            <TabItem x:Name="TabPersonal">
                <DockPanel Margin="24,18,24,20">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button x:Name="BtnRead" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Read_Click"/>
                        <Button x:Name="BtnPrint" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Print_Click"/>
                        <Button x:Name="BtnPdf" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Pdf_Click"/>
                        <Button x:Name="BtnVerify" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Click="Verify_Click"/>
                        <Border x:Name="PillSig" CornerRadius="14" Padding="12,6" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="LblSig" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                    </WrapPanel>

                    <TextBlock x:Name="LblHint" DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="2,24,0,0"/>

                    <Grid x:Name="PersonalContent" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="170" Height="215" CornerRadius="12" Background="#EEF1F7" ClipToBounds="True">
                                    <Image x:Name="ImgPortrait" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock x:Name="LblName" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,2"/>
                                <TextBlock x:Name="LblDocType" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="FieldsPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Token -->
            <TabItem x:Name="TabToken">
                <DockPanel Margin="24,18,24,20">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button x:Name="BtnReadToken" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Click="ReadToken_Click"/>
                        <TextBlock x:Name="LblTokenInfo" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </DockPanel>
                    <TextBlock x:Name="LblPinNote" DockPanel.Dock="Bottom" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,14,0,0"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock x:Name="LblCerts" DockPanel.Dock="Top" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="LstCerts"/>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- About -->
            <TabItem x:Name="TabAbout">
                <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,32" MaxWidth="520">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="app.ico" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="LblAboutTitle" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,8"/>
                        <TextBlock x:Name="LblAboutText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="LblVersion" HorizontalAlignment="Center" Margin="0,18,0,8" FontWeight="SemiBold"/>
                        <Button x:Name="BtnCheckUpdates" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Click="CheckUpdates_Click"/>
                        <TextBlock x:Name="LblUpdateStatus" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
