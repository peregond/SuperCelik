<Window x:Class="SerbiaID.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Super Celik" Icon="app.ico" Width="1020" Height="720" MinWidth="820" MinHeight="600"
        Background="{DynamicResource BgBrush}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Update banner -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="{DynamicResource BannerBrush}" Padding="24,9" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="BtnUpdate" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Update_Click"/>
                <TextBlock x:Name="LblUpdate" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Source="app.ico" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LblBrand" Foreground="{DynamicResource TextBrush}" FontSize="19" FontWeight="Bold"/>
                        <TextBlock x:Name="LblBrandSub" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ComboBox x:Name="CmbLang" DockPanel.Dock="Right" Width="110" Height="34" SelectionChanged="Lang_Changed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                    <Border x:Name="PillCard" CornerRadius="14" Padding="12,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotCard" Width="8" Height="8" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LblCard" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="CmbReader" Width="250" Height="34" SelectionChanged="CmbReader_Changed"/>
                    <Button x:Name="BtnRefresh" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Refresh_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Busy indicator -->
        <ProgressBar x:Name="BusyBar" DockPanel.Dock="Top" Height="3" IsIndeterminate="True" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource RedBrush}"/>

        <!-- Friendly problem banner -->
        <Border x:Name="ProblemBanner" DockPanel.Dock="Top" Background="{DynamicResource BadBgBrush}" Padding="24,10" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="BtnProblemClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Top" Click="ProblemClose_Click"/>
                <StackPanel>
                    <TextBlock x:Name="LblProblemTitle" FontWeight="Bold" Foreground="{DynamicResource BadBrush}"/>
                    <TextBlock x:Name="LblProblemHint" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock x:Name="LblProblemTech" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs">
            <!-- Personal data -->
            <TabItem x:Name="TabPersonal">
                <DockPanel Margin="24,18,24,20">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button x:Name="BtnRead" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Read_Click"/>
                        <Button x:Name="BtnPrint" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Print_Click"/>
                        <Button x:Name="BtnPdf" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Pdf_Click"/>
                        <Button x:Name="BtnVerify" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Verify_Click"/>
                        <Button x:Name="BtnMore" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Click="More_Click">
                            <Button.ContextMenu><ContextMenu x:Name="MoreMenu"/></Button.ContextMenu>
                        </Button>
                        <Border x:Name="PillSig" CornerRadius="14" Padding="12,6" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="LblSig" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                    </WrapPanel>

                    <StackPanel x:Name="EmptyState" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,70,0,0">
                        <Image Source="app.ico" Width="84" Height="84" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="LblHint" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,16,0,0"/>
                    </StackPanel>

                    <Grid x:Name="PersonalContent" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="170" Height="215" CornerRadius="12" Background="{DynamicResource PlaceholderBrush}" ClipToBounds="True">
                                    <Image x:Name="ImgPortrait" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock x:Name="LblName" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,2"/>
                                <TextBlock x:Name="LblDocType" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"/>
                                <Border x:Name="PillExpiry" CornerRadius="14" Padding="12,5" Margin="0,12,0,0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="LblExpiry" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="FieldsPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Token -->
            <TabItem x:Name="TabToken">
                <DockPanel Margin="24,18,24,20">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button x:Name="BtnReadToken" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Click="ReadToken_Click"/>
                        <TextBlock x:Name="LblTokenInfo" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </DockPanel>
                    <TextBlock x:Name="LblPinNote" DockPanel.Dock="Bottom" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,14,0,0"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock x:Name="LblCerts" Foreground="{DynamicResource TextBrush}" DockPanel.Dock="Top" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="LstCerts"/></ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem x:Name="TabSettings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,20" MaxWidth="640" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="LblSetAppearance" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DockPanel>
                                    <ComboBox x:Name="CmbTheme" DockPanel.Dock="Right" Width="170" Height="34" SelectionChanged="Theme_Changed"/>
                                    <TextBlock x:Name="LblSetTheme" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="LblSetPrivacy" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkMask" Click="Setting_Click"/>
                                <CheckBox x:Name="ChkPrintJmbg" Click="Setting_Click"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBox x:Name="TxtAutoHide" DockPanel.Dock="Right" Width="60" Height="30" TextAlignment="Center" VerticalContentAlignment="Center" LostFocus="Setting_Click"/>
                                    <TextBlock x:Name="LblSetAutoHide" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="LblSetBehavior" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkAutoRead" Click="Setting_Click"/>
                                <CheckBox x:Name="ChkAutoUpdate" Click="Setting_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- About -->
            <TabItem x:Name="TabAbout">
                <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,32" MaxWidth="520">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="app.ico" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="LblAboutTitle" Foreground="{DynamicResource TextBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,8"/>
                        <TextBlock x:Name="LblAboutText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="LblVersion" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,18,0,8" FontWeight="SemiBold"/>
                        <Button x:Name="BtnCheckUpdates" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Click="CheckUpdates_Click"/>
                        <TextBlock x:Name="LblUpdateStatus" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
